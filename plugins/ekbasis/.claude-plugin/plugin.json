{
  "name": "ekbasis",
  "displayName": "Ekbasis",
  "version": "0.1.13",
  "description": "Foresee before you act: a git guard hook for the Bash tool, the ekbasis-guard skill and the Ekbasis MCP server (calibrated consequence predictions). Needs EKBASIS_API_KEY or EKBASIS_URL.",
  "author": {
    "name": "Caio Vicentino",
    "url": "https://openinterp.org/ekbasis"
  },
  "homepage": "https://openinterp.org/ekbasis",
  "repository": "https://github.com/OpenInterpretability/ekbasis",
  "license": "Apache-2.0",
  "keywords": ["git", "guard", "safety", "consequence-model", "hooks", "mcp"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.sh", "session-start"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.sh", "hook"],
            "timeout": 30
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ekbasis": {
      "command": "uv",
      "args": ["run", "--no-project", "--python", ">=3.10", "--with", "mcp>=1.2", "python",
               "${CLAUDE_PLUGIN_ROOT}/scripts/claude_plugin.py", "mcp"]
    }
  }
}
