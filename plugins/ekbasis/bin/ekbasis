#!/usr/bin/env python3
"""`ekbasis` on the Bash tool's PATH while the Claude Code plugin is enabled, from the plugin's own copy of the package
(a `pip install ekbasis` elsewhere on PATH may come first). Same as the installed `ekbasis` command, except that, as in
the plugin's hooks, EKBASIS_API_KEY without EKBASIS_URL means the hosted API, and with neither set it says how to set
Ekbasis up and exits 3 (cannot foresee)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from ekbasis.claude_plugin import cli  # noqa: E402

sys.exit(cli())
