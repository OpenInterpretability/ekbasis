#!/usr/bin/env python3
"""`ekbasis` on the Bash tool's PATH while the Claude Code plugin is enabled, from the plugin's own copy of the package
(a `pip install ekbasis` elsewhere on PATH may come first). Same as the installed `ekbasis` command, except that, as in
the plugin's hooks, EKBASIS_API_KEY without EKBASIS_URL means the hosted API."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from ekbasis.claude_plugin import configure  # noqa: E402
from ekbasis.cli import main  # noqa: E402

configure()
sys.exit(main())
